# Copy to .env (never committed). GCP authentication uses Application Default Credentials
# (gcloud auth application-default login): no key here.

# V'Lille public GBFS feed
VLILLE_GBFS_URL=https://media.ilevia.fr/opendata/gbfs.json

# GCP
GOOGLE_CLOUD_PROJECT=vlille-pipeline
GCP_REGION=europe-west1
GCS_RAW_BUCKET=vlille-pipeline-raw
BQ_DATASET_RAW=vlille_raw

# Local Kafka (kafka/docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
