# Modèle de configuration locale : copier en .env (jamais versionné) et compléter.
# L'authentification GCP passe par les Application Default Credentials
# (gcloud auth application-default login) : aucune clé à renseigner ici.

# Source V'Lille (flux GBFS public, sans clé)
VLILLE_GBFS_URL=https://media.ilevia.fr/opendata/gbfs.json

# GCP
GCP_PROJECT_ID=vlille-pipeline
GCP_REGION=europe-west1
GCS_RAW_BUCKET=
BQ_DATASET_RAW=vlille_raw
